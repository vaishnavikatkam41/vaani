# Copy this file to .env (same folder) and fill in your own values.
#   cp .env.example .env
# .env is in .gitignore: it never goes to GitHub. Never put keys in any other file.

# Sarvam AI key (free at https://dashboard.sarvam.ai). Gives the best Telugu speech
# recognition and Telugu answers. Without it, a local Telugu model is used.
SARVAM_API_KEY=

# Optional: turns on /admin/unanswered (send it as the X-Admin-Token header).
VAANI_ADMIN_TOKEN=
